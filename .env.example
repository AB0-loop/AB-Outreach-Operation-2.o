# Environment identity
APP_ENV=development
APP_BASE_URL=http://localhost:3000

# PostgreSQL pooled application connection. Use separate staging/production databases.
DATABASE_URL=postgresql://APP_USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DB_POOL_MAX=5

# Authentication and request protection (minimum 32 random characters each)
SESSION_PEPPER=
RATE_LIMIT_PEPPER=
TRUST_PROXY_HEADERS=false
ADMIN_BOOTSTRAP_TOKEN=

# Contact privacy and OAuth encryption
CONTACT_FINGERPRINT_PEPPER=
TOKEN_ENCRYPTION_KEY=base64:

# Inbound webhook HMAC secret; existing Aurum website is not connected until explicitly approved.
INBOUND_WEBHOOK_SECRET=

# Gmail send-only OAuth; leave unset until controlled test approval.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
LIVE_SENDING_ENABLED=false

# AI is disabled for MVP. These reserve a provider-independent future integration.
AI_PROVIDER=disabled
AI_MONTHLY_BUDGET_USD=0

# Backup destination used by production runbook
BACKUP_GCS_URI=gs://PROJECT-BACKUPS/aurum-acquisition

# Autonomous discovery (Google Places API (New) Text Search; only place IDs are stored)
GOOGLE_PLACES_API_KEY=
DISCOVERY_ENABLED=true
DISCOVERY_QUERIES_PER_DAY=8
DISCOVERY_RESULTS_PER_QUERY=10
DISCOVERY_DAILY_PLACES_CAP=30
WORKER_TIME_BUDGET_MS=2700000
DISCOVERY_PAGES_PER_QUERY=1
# Independent phone cross-check via Place Details (re-requested by stored place ID)
CROSSCHECK_PROSPECTS_PER_DAY=15
CROSSCHECK_DAILY_DETAILS_CAP=25
